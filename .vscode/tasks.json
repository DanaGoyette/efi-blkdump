{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EDK II: Build X64 (DEBUG)",
      "type": "shell",
      "command": "./build.sh X64 DEBUG",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "EDK2_DIR": "${config:edk2.path}"
        },
        "shell": {
          "executable": "/bin/bash",
          "args": ["-c"]
        }
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "EDK II: Build X64 (RELEASE)",
